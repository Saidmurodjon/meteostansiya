# Copy to v2-grafana/.env (gitignored) and fill in real values.
# Used both by docker compose and by bridge/dl1_bridge.py when run directly.

# Grafana admin login
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

# Station label written to VictoriaMetrics
DEFAULT_STATION=1

# docker compose: host ports
GRAFANA_PORT=3000
BRIDGE_PORT=8888
# VictoriaMetrics data retention
VM_RETENTION=5y

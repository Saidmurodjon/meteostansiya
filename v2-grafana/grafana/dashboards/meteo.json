     ]
    }
   }
  },
  {
   "type": "timeseries",
   "title": "Batareya kuchlanishi",
   "datasource": {
    "type": "prometheus",
    "uid": "vm"
   },
   "gridPos": {
    "x": 0,
    "y": 24,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "meteo_battery_voltage{station=\"$station\"}",
     "legendFormat": "Stansiya {{station}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "volt",
     "decimals": 2,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "orange",
        "value": 11.8
       },
       {
        "color": "green",
        "value": 12.4
       }
      ]
     },
     "custom": {
      "thresholdsStyle": {
       "mode": "line+area"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [

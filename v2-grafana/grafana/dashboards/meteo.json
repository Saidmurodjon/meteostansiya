{
 "uid": "meteo",
 "title": "Meteostansiyalar",
 "timezone": "browser",
 "refresh": "30s",
 "time": {
  "from": "now-1h",
  "to": "now"
 },
 "templating": {
  "list": [
   {
    "name": "station",
    "label": "Stansiya",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "vm"
    },
    "query": "label_values(meteo_temperature, station)",
    "refresh": 2
   }
  ]
 },
 "panels": [
  {
   "type": "timeseries",
   "title": "Harorat",
   "datasource": {
    "type": "prometheus",
    "uid": "vm"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "meteo_temperature{station=\"$station\"}",
     "legendFormat": "Stansiya {{station}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "celsius"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "min",
      "max",
      "mean",
      "lastNotNull"
     ]
    }
   }
  },
  {
   "type": "timeseries",
   "title": "Namlik",
   "datasource": {
    "type": "prometheus",
    "uid": "vm"
   },
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "meteo_humidity{station=\"$station\"}",
     "legendFormat": "Stansiya {{station}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percent"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "min",
      "max",
      "mean",
      "lastNotNull"
     ]
    }
   }
  },
  {
   "type": "timeseries",
   "title": "Yorug'lik",
   "datasource": {
    "type": "prometheus",
    "uid": "vm"
   },
   "gridPos": {
    "x": 0,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "meteo_light{station=\"$station\"}",
     "legendFormat": "Stansiya {{station}}"
    }
   ],
   "fieldConfig": {
    "defaults": {

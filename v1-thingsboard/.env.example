# Copy to v1-thingsboard/.env (gitignored) and fill in real values.
# Used both by the Python scripts and by docker compose.

# ThingsBoard tenant login (used by bridge/make_dashboard.py)
TB_USERNAME=
TB_PASSWORD=
# ThingsBoard device the bridge pushes to / the dashboard shows
TB_DEVICE_ID=
TB_DEVICE_TOKEN=

# Bridge
LISTEN_PORT=8888
LOGFILE=/tmp/dl1_bridge_v1.log

# docker compose: host ports
TB_HTTP_PORT=9090
BRIDGE_PORT=8888

# Legacy office-server scripts only (legacy/)
TB_TOKEN_STATION1=
TB_HOST_TAILSCALE=
